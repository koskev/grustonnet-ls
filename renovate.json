{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"dependencyDashboard": true,
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": [
			"* 0 * * 0"
		]
	},
	"nix": {
		"managerFilePatterns": [
			"/(^|/)flake\\.nix$/"
		],
		"commitMessageTopic": "nix",
		"commitMessageExtra": "to {{newValue}}",
		"enabled": true
	},
	"github-actions": {
		"enabled": false
	}
}
