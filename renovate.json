{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": [
			"* 0 * * 0"
		]
	},
	"nix": {
		"managerFilePatterns": [
			"/(^|/)flake\\.nix$/"
		],
		"commitMessageTopic": "nix",
		"commitMessageExtra": "to {{newValue}}",
		"enabled": true
	},
	"github-actions": {
		"enabled": false
	},
	"packageRules": [
		{
			"description": "Generate gomod2nix",
			"matchDatasources": [
				"go"
			],
			"postUpgradeTasks": {
				"commands": [
					"nix run .#gomod"
				],
				"fileFilters": [
					"**/*"
				],
				"executionMode": "update"
			}
		}
	]
}
